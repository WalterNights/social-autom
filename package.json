{
  "name": "linkedin-ops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cola de contenido para LinkedIn: valida, renderiza imagenes y publica.",
  "scripts": {
    "lint": "node --env-file-if-exists=.env src/lint.js",
    "render": "node --env-file-if-exists=.env src/render.js",
    "next": "node --env-file-if-exists=.env src/publish.js --dry",
    "publish": "node --env-file-if-exists=.env src/publish.js",
    "auth": "node --env-file-if-exists=.env src/auth.js",
    "estado": "node --env-file-if-exists=.env src/estado.js",
    "import": "node scripts/import-serie.js",
    "new": "node scripts/new.js"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=22"
  }
}
