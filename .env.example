# --- LinkedIn ---
# Se sacan del portal de desarrolladores, en la pestaña "Auth" de tu app.
LI_CLIENT_ID=
LI_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URL registrada en la app.
LI_REDIRECT_URI=http://localhost:5599/callback
# Versión de la API, formato YYYYMM. Súbela cuando LinkedIn deprecie la anterior.
LI_VERSION=202601
# Tu usuario, se imprime en la esquina de las imágenes. Opcional.
LI_HANDLE=@tu-usuario

# --- Aprobación por Telegram (opcional, solo para `npm run publish -- --ask`) ---
# Bot creado con @BotFather. El chat id lo da @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=
